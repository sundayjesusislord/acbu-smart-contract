# Normalize LF line endings for text files so CRLF corruption cannot
# silently recur. Git attributes do not convert or validate file encoding.
# Existing repository history is not rewritten by these rules.
* text=auto eol=lf

# Explicit text formats present in this repo
*.rs      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.txt     text eol=lf
*.lock    text eol=lf
Makefile  text eol=lf
# Version-pin dotfiles
.nvmrc        text eol=lf

# Windows-specific scripts keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files — no line-ending conversion
/build/** binary
*.wasm    binary
*.pyc     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary